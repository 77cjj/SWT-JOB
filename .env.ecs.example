# 复制为仓库根目录的 .env.ecs（已 gitignore），供 ./scripts/ecs.sh 与本机 Cursor Agent 使用。
# 不要把 AccessKey 写进这个文件；凭证只放本机 ~/.workbench/config.json。

# ECS 控制台 → 实例 ID（杭州公共镜像多为 i-bp 前缀）
SWT_ECS_INSTANCE_ID=i-bpxxxxxxxxxxxxxxxx

# 与实例所在地域一致；通常可按实例 ID 前缀自动推断
SWT_ECS_REGION=cn-hangzhou

# GitHub Actions Secret ALIYUN_DEPLOY_PATH 的同一路径
SWT_ECS_DEPLOY_PATH=/root/swt-job

# 登录用户（Workbench 免密默认 root）
SWT_ECS_USER=root

# 可选：多 Profile 时指定 workbench --profile
# SWT_ECS_PROFILE=default
